# Copy to .env and fill in. NEVER commit .env
GEMINI_API_KEY=
# 默认 gemini-3.6-flash（支持图片/PDF 输入），想换模型就改这里
GEMINI_MODEL=gemini-3.6-flash
# 1 = 不调用 Gemini，返回假数据（没 key / 没网 / 省配额 / demo 备用）
GEMINI_MOCK=0
# GEMINI_TIMEOUT=30
# MONGODB_URI=
ELEVENLABS_API_KEY=
# ElevenLabs Voice Library 里挑一个支持中英文的声音，复制 voice id
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
