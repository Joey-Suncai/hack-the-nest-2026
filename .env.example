# Copy to .env and fill in. NEVER commit .env
GEMINI_API_KEY=
# 默认 gemini-3.6-flash（支持图片/PDF 输入），想换模型就改这里
GEMINI_MODEL=gemini-3.6-flash
# 1 = 不调用 Gemini，返回假数据（没 key / 没网 / 省配额 / demo 备用）
GEMINI_MOCK=0
# GEMINI_TIMEOUT=30
# MONGODB_URI=
ELEVENLABS_API_KEY=
# ElevenLabs Voice Library 里挑一个支持中英文的声音，复制 voice id
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# 1 = 两步定位：小框裁剪放大后再问一次 Gemini（A3 评测：IoU 无提升、每步多 ~2.7s，默认关）
SHOWME_REFINE=0
# 语音输入（/api/transcribe）用的 ElevenLabs Speech-to-Text 模型
ELEVENLABS_STT_MODEL=scribe_v2
# 实时语音（ElevenLabs Agent）：运行 cd backend && uv run python scripts/create_agent.py --write-env 自动填
ELEVENLABS_AGENT_ID=
# 口令：设了以后，客户端请求要带 X-ShowMe-Token 请求头（/api/health 除外）。局域网联调时一定要设
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(12))"
SHOWME_TOKEN=
